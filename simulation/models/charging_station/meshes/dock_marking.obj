# charging pad marking (top face, normal +Z)
mtllib dock_marking.mtl
o marking
v -0.50000 0.50000 0.00200
v -0.50000 -0.50000 0.00200
v 0.50000 -0.50000 0.00200
v 0.50000 0.50000 0.00200
vt 0.00000 0.00000
vt 1.00000 0.00000
vt 1.00000 1.00000
vt 0.00000 1.00000
vn 0 0 1
usemtl charging_station_marking
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
