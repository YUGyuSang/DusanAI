<!--
  Spot-like quadruped "spot" for Gazebo (gz-sim 8 Harmonic ... 10 Jetty) and RViz.

  * Kinematics / limits / masses mirror dusan_common/dusan_common/robot_model.py
    (tools/test/test_spot_assets.py checks every number).
  * Zero joint angles = legs straight down.  hip_y > 0 swings the foot backwards,
    knee < 0 bends the knee backwards (all legs).  Leg order FL, FR, RL, RR.
  * Visual meshes: simulation/models/spot/meshes/*.obj (generated by
    tools/convert_spot.py from the Unity rig, already expressed in the link frames).
  * Collisions are primitives only (box trunk, box thighs, cylinder shins, sphere
    feet); self collision is off (SDF default for models).
  * <gazebo> blocks are written so that sdformat's URDF->SDF converter keeps them:
    model-level plugins in <gazebo> without reference, sensors / surface
    parameters in <gazebo reference="link">.  Massless fixed links (feet, sensor
    links) are lumped into their parents by sdformat; sensors and foot friction
    follow automatically, and the frames stay available as SDF <frame>s.

  Expand:  xacro spot.urdf.xacro > spot.urdf
  Args:    mesh_uri_prefix  (default package://plant_simulation/models/spot/meshes;
                             pass file:///abs/path/meshes if package:// cannot be resolved)
           enable_gazebo    (true)  - plugins + sensors
           enable_cameras   (true)  - depth / inspection / thermal cameras
           enable_thermal   (true)  - thermal camera only (needs the ogre2 thermal pipeline)
-->
<robot name="spot">
  <material name="spot_foot_rubber">
    <color rgba="0.06 0.06 0.06 1.0"/>
  </material>
  <!-- ===================== trunk ===================== -->
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.004 0 0.002"/>
      <mass value="8.0"/>
