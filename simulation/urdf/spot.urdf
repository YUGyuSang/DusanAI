      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://plant_simulation/models/spot/meshes/rr_upper_leg.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="rr_upper_leg_collision">
      <origin rpy="0 0 0" xyz="-0.006 0 -0.115"/>
      <geometry>
        <box size="0.06 0.05 0.24"/>
      </geometry>
    </collision>
  </link>
  <joint name="rr_knee" type="revolute">
    <parent link="rr_upper_leg"/>
    <child link="rr_lower_leg"/>
    <origin rpy="0 0 0" xyz="0 0 -0.2256"/>
    <axis xyz="0 1 0"/>
    <limit effort="60.0" lower="-2.8" upper="-0.2" velocity="15.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <link name="rr_lower_leg">
    <inertial>
      <origin rpy="0 0 0" xyz="0.01 0 -0.14"/>
      <mass value="0.25"/>
      <inertia ixx="0.0018872518750000006" ixy="0.0" ixz="0.0" iyy="0.0018872518750000006" iyz="0.0" izz="3.2e-05"/>
    </inertial>
    <visual name="rr_lower_leg_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://plant_simulation/models/spot/meshes/rr_lower_leg.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="rr_lower_leg_collision">
      <origin rpy="0 0 0" xyz="0.012 0 -0.1475"/>
      <geometry>
        <cylinder length="0.235" radius="0.016"/>
      </geometry>
    </collision>
  </link>
  <joint name="rr_foot_fixed" type="fixed">
    <parent link="rr_lower_leg"/>
    <child link="rr_foot"/>
    <origin rpy="0 0 0" xyz="0 0 -0.2997"/>
  </joint>
  <!-- massless: lumped into the lower leg by sdformat (total mass stays 15 kg).
         Keep the collision name "<link>_collision": sdformat matches the
         <gazebo reference="..._foot"> friction to the lumped collision by it. -->
  <link name="rr_foot">
    <visual name="rr_foot_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="spot_foot_rubber"/>
    </visual>
    <collision name="rr_foot_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="rr_foot">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rr_hip_x</joint_name>
      <topic>/spot/joint/rr_hip_x/cmd_pos</topic>
      <use_velocity_commands>false</use_velocity_commands>
      <cmd_max>45.0</cmd_max>
      <cmd_min>-45.0</cmd_min>
      <p_gain>450.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>3.0</d_gain>
      <initial_position>0.0</initial_position>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rr_hip_y</joint_name>
      <topic>/spot/joint/rr_hip_y/cmd_pos</topic>
      <use_velocity_commands>false</use_velocity_commands>
      <cmd_max>45.0</cmd_max>
      <cmd_min>-45.0</cmd_min>
      <p_gain>450.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>3.0</d_gain>
      <initial_position>0.0</initial_position>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rr_knee</joint_name>
      <topic>/spot/joint/rr_knee/cmd_pos</topic>
      <use_velocity_commands>false</use_velocity_commands>
      <cmd_max>60.0</cmd_max>
      <cmd_min>-60.0</cmd_min>
      <p_gain>450.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>3.0</d_gain>
      <initial_position>-0.2</initial_position>
    </plugin>
  </gazebo>
  <joint name="imu_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
  </joint>
  <link name="imu_link"/>
  <joint name="depth_camera_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin rpy="0 0.60 0" xyz="0.34 0.0 0.0"/>
  </joint>
  <link name="depth_camera_link"/>
  <joint name="inspection_camera_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="inspection_camera_link"/>
    <origin rpy="0 -0.30 0" xyz="0.30 0.0 0.20"/>
  </joint>
  <link name="inspection_camera_link"/>
  <joint name="thermal_camera_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="thermal_camera_link"/>
    <origin rpy="0 -0.30 0" xyz="0.30 -0.05 0.20"/>
  </joint>
  <link name="thermal_camera_link"/>
  <joint name="depth_camera_optical_joint" type="fixed">
    <parent link="depth_camera_link"/>
    <child link="depth_camera_optical_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <link name="depth_camera_optical_frame"/>
  <joint name="inspection_camera_optical_joint" type="fixed">
    <parent link="inspection_camera_link"/>
    <child link="inspection_camera_optical_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <link name="inspection_camera_optical_frame"/>
  <joint name="thermal_camera_optical_joint" type="fixed">
    <parent link="thermal_camera_link"/>
    <child link="thermal_camera_optical_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <link name="thermal_camera_optical_frame"/>
  <gazebo>
    <!-- gz topic /world/<world>/model/spot/joint_state (all joints).
           update_rate throttles the stream (default: every 1 ms physics step,
           i.e. 1 kHz into the bridge and the Python controllers); a gz version
           without the option ignores the element and publishes every step. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <update_rate>200</update_rate>
    </plugin>
    <!-- ground-truth odometry of base_link -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/spot/odometry</odom_topic>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>
  <!-- ===================== Gazebo: sensors ===================== -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>false</visualize>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <!-- depth image (R_FLOAT32, metres) + organised cloud on <topic>/points -->
  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/depth_camera/image</topic>
      <gz_frame_id>depth_camera_link</gz_frame_id>
      <camera name="depth_camera">
        <horizontal_fov>1.5</horizontal_fov>
        <image>
          <width>212</width>
          <height>120</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>4.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>4.0</far>
          </clip>
        </depth_camera>
        <camera_info_topic>/depth_camera/camera_info</camera_info_topic>
      </camera>
    </sensor>
  </gazebo>
  <!-- RGB inspection camera (gauge reading) -->
  <gazebo reference="inspection_camera_link">
    <sensor name="inspection_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/inspection_camera/image</topic>
      <gz_frame_id>inspection_camera_link</gz_frame_id>
      <camera name="inspection_camera">
        <horizontal_fov>0.9</horizontal_fov>
        <image>
          <width>800</width>
          <height>600</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
        <camera_info_topic>/inspection_camera/camera_info</camera_info_topic>
      </camera>
    </sensor>
  </gazebo>
  <!-- thermal camera: L16, Kelvin = value * 0.01 -->
  <gazebo reference="thermal_camera_link">
    <sensor name="thermal_camera" type="thermal">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <visualize>false</visualize>
      <topic>/thermal_camera/image</topic>
      <gz_frame_id>thermal_camera_link</gz_frame_id>
      <camera name="thermal_camera">
        <horizontal_fov>0.8</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>L16</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>50.0</far>
        </clip>
        <camera_info_topic>/thermal_camera/camera_info</camera_info_topic>
      </camera>
      <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
        <min_temp>253.15</min_temp>
        <max_temp>655.0</max_temp>
        <resolution>0.01</resolution>
      </plugin>
    </sensor>
  </gazebo>
</robot>
