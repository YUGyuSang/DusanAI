<?xml version="1.0"?>
<!--
  Spot-like quadruped "spot" for Gazebo (gz-sim 8 Harmonic ... 10 Jetty) and RViz.

  * Kinematics / limits / masses mirror dusan_common/dusan_common/robot_model.py
    (tools/test/test_spot_assets.py checks every number).
  * Zero joint angles = legs straight down.  hip_y > 0 swings the foot backwards,
    knee < 0 bends the knee backwards (all legs).  Leg order FL, FR, RL, RR.
  * Visual meshes: simulation/models/spot/meshes/*.obj (generated by
    tools/convert_spot.py from the Unity rig, already expressed in the link frames).
  * Collisions are primitives only (box trunk, box thighs, cylinder shins, sphere
    feet); self collision is off (SDF default for models).
  * <gazebo> blocks are written so that sdformat's URDF->SDF converter keeps them:
    model-level plugins in <gazebo> without reference, sensors / surface
    parameters in <gazebo reference="link">.  Massless fixed links (feet, sensor
    links) are lumped into their parents by sdformat; sensors and foot friction
    follow automatically, and the frames stay available as SDF <frame>s.

  Expand:  xacro spot.urdf.xacro > spot.urdf
  Args:    mesh_uri_prefix  (default package://plant_simulation/models/spot/meshes;
                             pass file:///abs/path/meshes if package:// cannot be resolved)
           enable_gazebo    (true)  - plugins + sensors
           enable_cameras   (true)  - depth / inspection / thermal cameras
           enable_thermal   (true)  - thermal camera only (needs the ogre2 thermal pipeline)
           depth_rate (10) inspection_rate (10) thermal_rate (5)       - camera update rates [Hz]
           inspection_width (800) inspection_height (600)              - inspection camera image size
                            (bringup low_memory:=true: 640 x 480 @ 5 Hz, depth 10 Hz, thermal 2 Hz)
-->
<robot name="spot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="mesh_uri_prefix" default="package://plant_simulation/models/spot/meshes"/>
  <xacro:arg name="enable_gazebo" default="true"/>
  <xacro:arg name="enable_cameras" default="true"/>
  <xacro:arg name="enable_thermal" default="true"/>
  <xacro:arg name="depth_rate" default="10"/>
  <xacro:arg name="inspection_rate" default="10"/>
  <xacro:arg name="thermal_rate" default="5"/>
  <xacro:arg name="inspection_width" default="800"/>
  <xacro:arg name="inspection_height" default="600"/>
  <xacro:property name="mesh_prefix" value="$(arg mesh_uri_prefix)"/>

  <!-- ===================== robot_model.py constants =====================
       geometry: HIP_X_OFFSET, HIP_Y_OFFSET, HIP_TO_THIGH_Y, UPPER_LEG_LENGTH,
       LOWER_LEG_LENGTH, FOOT_RADIUS; masses: BASE/HIP/UPPER_LEG/LOWER_LEG_MASS;
       trunk: BASE_BOX, BASE_INERTIA; JOINT_LIMITS; JOINT_SERVO_P_GAIN / _D_GAIN. -->
  <xacro:property name="hip_x_offset" value="0.2245"/>
  <xacro:property name="hip_y_offset" value="0.044"/>
  <xacro:property name="hip_to_thigh_y" value="0.090"/>
  <xacro:property name="upper_leg_length" value="0.2256"/>
  <xacro:property name="lower_leg_length" value="0.2997"/>
  <xacro:property name="foot_radius" value="0.025"/>

  <xacro:property name="base_mass" value="8.0"/>
  <xacro:property name="hip_mass" value="0.6"/>
  <xacro:property name="upper_leg_mass" value="0.9"/>
  <xacro:property name="lower_leg_mass" value="0.25"/>
  <xacro:property name="base_box_x" value="0.60"/>
  <xacro:property name="base_box_y" value="0.22"/>
  <xacro:property name="base_box_z" value="0.14"/>
  <xacro:property name="base_ixx" value="0.0453"/>
  <xacro:property name="base_iyy" value="0.2531"/>
  <xacro:property name="base_izz" value="0.2723"/>

  <xacro:property name="hip_x_lower" value="-0.70"/>
  <xacro:property name="hip_x_upper" value="0.70"/>
  <xacro:property name="hip_x_effort" value="45.0"/>
  <xacro:property name="hip_x_velocity" value="15.0"/>
  <xacro:property name="hip_y_lower" value="-1.60"/>
  <xacro:property name="hip_y_upper" value="2.60"/>
  <xacro:property name="hip_y_effort" value="45.0"/>
  <xacro:property name="hip_y_velocity" value="15.0"/>
  <xacro:property name="knee_lower" value="-2.80"/>
  <xacro:property name="knee_upper" value="-0.20"/>
  <xacro:property name="knee_effort" value="60.0"/>
  <xacro:property name="knee_velocity" value="15.0"/>

  <xacro:property name="joint_damping" value="0.1"/>
  <xacro:property name="joint_friction" value="0.05"/>
  <!-- joint servo = gz JointPositionController in PID force mode (DESIGN_SPEC §3):
       tau = -(p e + d de/dt), e = q - q_target, clamped to +-effort (cmd_max/min).
       MuJoCo physics check (tools/physics_check.py): the velocity mode
       (use_velocity_commands, target reached in one 1 ms step) made every
       100 Hz target step a rigid jerk of four position-locked legs (feet
       bouncing / slipping, 90 % of the stance frames without contact).  d is
       bounded by the light shank: d dt / I_knee (I_knee ~ 0.0056 kg m^2) must
       stay well below 1 at the 1 ms step (d 6 diverged); p 450 keeps the
       stance sag small (the controller feeds the MPC torques forward as
       tau / p, locomotion.yaml servo_kp must equal servo_p_gain). -->
  <xacro:property name="servo_p_gain" value="450.0"/>
  <xacro:property name="servo_d_gain" value="3.0"/>
  <!-- joint state publication rate (Hz): 2x the 100 Hz locomotion loop -->
  <xacro:property name="joint_state_rate" value="200"/>

  <!-- ===================== geometry fitted to the meshes ===================== -->
  <!-- trunk box centred on the base_link mesh bounding box (x -0.341..0.332, z -0.065..0.069) -->
  <xacro:property name="base_box_cx" value="-0.004"/>
  <xacro:property name="base_box_cz" value="0.002"/>
  <!-- hip housing: cylinder about the link y axis, offset towards the body centre -->
  <xacro:property name="hip_radius" value="0.041"/>
  <xacro:property name="hip_length" value="0.075"/>
  <xacro:property name="hip_cx" value="0.010"/>
  <xacro:property name="hip_cy" value="0.011"/>
  <!-- thigh box (hip_y joint .. knee) -->
  <xacro:property name="thigh_box_x" value="0.060"/>
  <xacro:property name="thigh_box_y" value="0.050"/>
  <xacro:property name="thigh_box_z" value="0.240"/>
  <xacro:property name="thigh_cx" value="-0.006"/>
  <xacro:property name="thigh_cz" value="-0.115"/>
  <!-- shin cylinder (the mesh shin bows forward by ~2 cm) -->
  <xacro:property name="shin_radius" value="0.016"/>
  <xacro:property name="shin_length" value="0.235"/>
  <xacro:property name="shin_cx" value="0.012"/>
  <xacro:property name="shin_cz" value="-0.1475"/>
  <xacro:property name="lower_com_cx" value="0.010"/>
  <xacro:property name="lower_com_cz" value="-0.140"/>

  <!-- foot contact: high friction rubber -->
  <xacro:property name="foot_mu" value="1.0"/>

  <!-- ===================== helpers ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m * (y * y + z * z) / 12.0}" ixy="0.0" ixz="0.0"
             iyy="${m * (x * x + z * z) / 12.0}" iyz="0.0"
             izz="${m * (x * x + y * y) / 12.0}"/>
  </xacro:macro>
  <!-- solid cylinder, symmetry axis = link z -->
  <xacro:macro name="cylinder_inertia_z" params="m r h">
    <inertia ixx="${m * (3.0 * r * r + h * h) / 12.0}" ixy="0.0" ixz="0.0"
             iyy="${m * (3.0 * r * r + h * h) / 12.0}" iyz="0.0"
             izz="${m * r * r / 2.0}"/>
  </xacro:macro>
  <!-- solid cylinder, symmetry axis = link y -->
  <xacro:macro name="cylinder_inertia_y" params="m r h">
    <inertia ixx="${m * (3.0 * r * r + h * h) / 12.0}" ixy="0.0" ixz="0.0"
             iyy="${m * r * r / 2.0}" iyz="0.0"
             izz="${m * (3.0 * r * r + h * h) / 12.0}"/>
  </xacro:macro>

  <material name="spot_foot_rubber">
    <color rgba="0.06 0.06 0.06 1.0"/>
  </material>

  <!-- ===================== trunk ===================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="${base_box_cx} 0 ${base_box_cz}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="${base_ixx}" ixy="0.0" ixz="0.0" iyy="${base_iyy}" iyz="0.0" izz="${base_izz}"/>
    </inertial>
    <visual name="base_link_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/base_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual name="base_cam_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/base_cam.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual name="base_eap_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/base_eap.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="base_link_collision">
      <origin xyz="${base_box_cx} 0 ${base_box_cz}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_box_x} ${base_box_y} ${base_box_z}"/>
      </geometry>
    </collision>
  </link>

  <!-- ===================== legs ===================== -->
  <!-- leg: name prefix, sx = +1 front / -1 rear, sy = +1 left / -1 right -->
  <xacro:macro name="leg" params="leg sx sy">

    <joint name="${leg}_hip_x" type="revolute">
      <parent link="base_link"/>
      <child link="${leg}_hip"/>
      <origin xyz="${sx * hip_x_offset} ${sy * hip_y_offset} 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${hip_x_lower}" upper="${hip_x_upper}" effort="${hip_x_effort}" velocity="${hip_x_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <link name="${leg}_hip">
      <inertial>
        <origin xyz="${-sx * hip_cx} ${sy * hip_cy} 0" rpy="0 0 0"/>
        <mass value="${hip_mass}"/>
        <xacro:cylinder_inertia_y m="${hip_mass}" r="${hip_radius}" h="${hip_length}"/>
      </inertial>
      <visual name="${leg}_hip_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_prefix}/${leg}_hip.obj" scale="1 1 1"/>
        </geometry>
      </visual>
      <!-- no collision: the hip housing lies inside the trunk box -->
    </link>

    <joint name="${leg}_hip_y" type="revolute">
      <parent link="${leg}_hip"/>
      <child link="${leg}_upper_leg"/>
      <origin xyz="0 ${sy * hip_to_thigh_y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${hip_y_lower}" upper="${hip_y_upper}" effort="${hip_y_effort}" velocity="${hip_y_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <link name="${leg}_upper_leg">
      <inertial>
        <origin xyz="0 0 ${-0.5 * upper_leg_length}" rpy="0 0 0"/>
        <mass value="${upper_leg_mass}"/>
        <xacro:box_inertia m="${upper_leg_mass}" x="${thigh_box_x}" y="${thigh_box_y}" z="${upper_leg_length}"/>
      </inertial>
      <visual name="${leg}_upper_leg_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_prefix}/${leg}_upper_leg.obj" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision name="${leg}_upper_leg_collision">
        <origin xyz="${thigh_cx} 0 ${thigh_cz}" rpy="0 0 0"/>
        <geometry>
          <box size="${thigh_box_x} ${thigh_box_y} ${thigh_box_z}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${leg}_knee" type="revolute">
      <parent link="${leg}_upper_leg"/>
      <child link="${leg}_lower_leg"/>
      <origin xyz="0 0 ${-upper_leg_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${knee_lower}" upper="${knee_upper}" effort="${knee_effort}" velocity="${knee_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <link name="${leg}_lower_leg">
      <inertial>
        <origin xyz="${lower_com_cx} 0 ${lower_com_cz}" rpy="0 0 0"/>
        <mass value="${lower_leg_mass}"/>
        <xacro:cylinder_inertia_z m="${lower_leg_mass}" r="${shin_radius}" h="${lower_leg_length}"/>
      </inertial>
      <visual name="${leg}_lower_leg_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_prefix}/${leg}_lower_leg.obj" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision name="${leg}_lower_leg_collision">
        <origin xyz="${shin_cx} 0 ${shin_cz}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${shin_radius}" length="${shin_length}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${leg}_foot_fixed" type="fixed">
      <parent link="${leg}_lower_leg"/>
      <child link="${leg}_foot"/>
      <origin xyz="0 0 ${-lower_leg_length}" rpy="0 0 0"/>
    </joint>

    <!-- massless: lumped into the lower leg by sdformat (total mass stays 15 kg).
         Keep the collision name "<link>_collision": sdformat matches the
         <gazebo reference="..._foot"> friction to the lumped collision by it. -->
    <link name="${leg}_foot">
      <visual name="${leg}_foot_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${foot_radius}"/>
        </geometry>
        <material name="spot_foot_rubber"/>
      </visual>
      <collision name="${leg}_foot_collision">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${foot_radius}"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference="${leg}_foot">
      <mu1>${foot_mu}</mu1>
      <mu2>${foot_mu}</mu2>
    </gazebo>

    <xacro:if value="$(arg enable_gazebo)">
      <xacro:joint_servo joint="${leg}_hip_x" initial="0.0" effort="${hip_x_effort}"/>
      <xacro:joint_servo joint="${leg}_hip_y" initial="0.0" effort="${hip_y_effort}"/>
      <!-- the knee range [-2.80, -0.20] excludes 0: start the servo at the limit -->
      <xacro:joint_servo joint="${leg}_knee" initial="${knee_upper}" effort="${knee_effort}"/>
    </xacro:if>
  </xacro:macro>

  <!-- gz JointPositionController: /spot/joint/<joint>/cmd_pos (gz.msgs.Double),
       PID force mode (use_velocity_commands false), |force| <= cmd_max = effort -->
  <xacro:macro name="joint_servo" params="joint initial effort">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <topic>/spot/joint/${joint}/cmd_pos</topic>
        <use_velocity_commands>false</use_velocity_commands>
        <cmd_max>${effort}</cmd_max>
        <cmd_min>${-effort}</cmd_min>
        <p_gain>${servo_p_gain}</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>${servo_d_gain}</d_gain>
        <initial_position>${initial}</initial_position>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:leg leg="fl" sx="1" sy="1"/>
  <xacro:leg leg="fr" sx="1" sy="-1"/>
  <xacro:leg leg="rl" sx="-1" sy="1"/>
  <xacro:leg leg="rr" sx="-1" sy="-1"/>

  <!-- ===================== sensor frames (robot_model.SENSORS) ===================== -->
  <!-- camera links: Gazebo convention, the camera looks along +X; positive pitch = down -->
  <xacro:macro name="sensor_frame" params="name xyz rpy">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <link name="${name}"/>
  </xacro:macro>
  <!-- REP-103 optical frame (z forward, x right, y down) for ROS image consumers -->
  <xacro:macro name="optical_frame" params="camera">
    <joint name="${camera}_optical_joint" type="fixed">
      <parent link="${camera}_link"/>
      <child link="${camera}_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>
    <link name="${camera}_optical_frame"/>
  </xacro:macro>

  <xacro:sensor_frame name="imu_link" xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  <xacro:sensor_frame name="depth_camera_link" xyz="0.34 0.0 0.0" rpy="0 0.60 0"/>
  <xacro:sensor_frame name="inspection_camera_link" xyz="0.30 0.0 0.20" rpy="0 -0.30 0"/>
  <xacro:sensor_frame name="thermal_camera_link" xyz="0.30 -0.05 0.20" rpy="0 -0.30 0"/>
  <xacro:optical_frame camera="depth_camera"/>
  <xacro:optical_frame camera="inspection_camera"/>
  <xacro:optical_frame camera="thermal_camera"/>

  <!-- ===================== Gazebo: model plugins ===================== -->
  <xacro:if value="$(arg enable_gazebo)">
    <gazebo>
      <!-- gz topic /world/<world>/model/spot/joint_state (all joints).
           update_rate throttles the stream (default: every 1 ms physics step,
           i.e. 1 kHz into the bridge and the Python controllers); a gz version
           without the option ignores the element and publishes every step. -->
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <update_rate>${joint_state_rate}</update_rate>
      </plugin>
      <!-- ground-truth odometry of base_link -->
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/spot/odometry</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>

    <!-- ===================== Gazebo: sensors ===================== -->
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>false</visualize>
        <topic>/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <xacro:if value="$(arg enable_cameras)">
      <!-- depth image (R_FLOAT32, metres) + organised cloud on <topic>/points -->
      <gazebo reference="depth_camera_link">
        <sensor name="depth_camera" type="depth_camera">
          <always_on>true</always_on>
          <update_rate>$(arg depth_rate)</update_rate>
          <visualize>false</visualize>
          <topic>/depth_camera/image</topic>
          <gz_frame_id>depth_camera_link</gz_frame_id>
          <camera name="depth_camera">
            <horizontal_fov>1.5</horizontal_fov>
            <image>
              <width>212</width>
              <height>120</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>4.0</far>
            </clip>
            <depth_camera>
              <clip>
                <near>0.1</near>
                <far>4.0</far>
              </clip>
            </depth_camera>
            <camera_info_topic>/depth_camera/camera_info</camera_info_topic>
          </camera>
        </sensor>
      </gazebo>

      <!-- RGB inspection camera (gauge reading) -->
      <gazebo reference="inspection_camera_link">
        <sensor name="inspection_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>$(arg inspection_rate)</update_rate>
          <visualize>false</visualize>
          <topic>/inspection_camera/image</topic>
          <gz_frame_id>inspection_camera_link</gz_frame_id>
          <camera name="inspection_camera">
            <horizontal_fov>0.9</horizontal_fov>
            <image>
              <width>$(arg inspection_width)</width>
              <height>$(arg inspection_height)</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>50.0</far>
            </clip>
            <camera_info_topic>/inspection_camera/camera_info</camera_info_topic>
          </camera>
        </sensor>
      </gazebo>

      <xacro:if value="$(arg enable_thermal)">
        <!-- thermal camera: L16, Kelvin = value * 0.01 -->
        <gazebo reference="thermal_camera_link">
          <sensor name="thermal_camera" type="thermal">
            <always_on>true</always_on>
            <update_rate>$(arg thermal_rate)</update_rate>
            <visualize>false</visualize>
            <topic>/thermal_camera/image</topic>
            <gz_frame_id>thermal_camera_link</gz_frame_id>
            <camera name="thermal_camera">
              <horizontal_fov>0.8</horizontal_fov>
              <image>
                <width>320</width>
                <height>240</height>
                <format>L16</format>
              </image>
              <clip>
                <near>0.1</near>
                <far>50.0</far>
              </clip>
              <camera_info_topic>/thermal_camera/camera_info</camera_info_topic>
            </camera>
            <plugin filename="gz-sim-thermal-sensor-system"
                    name="gz::sim::systems::ThermalSensor">
              <min_temp>253.15</min_temp>
              <max_temp>655.0</max_temp>
              <resolution>0.01</resolution>
            </plugin>
          </sensor>
        </gazebo>
      </xacro:if>
    </xacro:if>
  </xacro:if>

</robot>
